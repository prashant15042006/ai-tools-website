{
  "short_name": "Nexuss Ai",
  "name": "Nexuss Ai — Intelligent Workspace",
  "description": "Your all-in-one AI workspace for chat, code generation, and content writing.",
  "id": "com.nexusai.workspace",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [],
  "iarc_rating_id": "none",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "icons": [
    { "src": "icon-192.png", "type": "image/png", "sizes": "96x96", "purpose": "any" },
    { "src": "icon-192.png", "type": "image/png", "sizes": "114x114", "purpose": "any" },
    { "src": "icon-192.png", "type": "image/png", "sizes": "128x128", "purpose": "any" },
    { "src": "icon-192.png", "type": "image/png", "sizes": "144x144", "purpose": "any" },
    { "src": "icon-192.png", "type": "image/png", "sizes": "192x192", "purpose": "any" },
    { "src": "icon-512.png", "type": "image/png", "sizes": "256x256", "purpose": "any" },
    { "src": "icon-512.png", "type": "image/png", "sizes": "384x384", "purpose": "any" },
    { "src": "icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "any" },
    { "src": "icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshot_mobile.jpg",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Nexuss Ai Mobile Chat"
    },
    {
      "src": "screenshot_desktop.jpg",
      "sizes": "1920x1080",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Nexuss Ai Desktop Dashboard"
    }
  ],
  "start_url": "/",
  "scope": "/",
  "orientation": "portrait-primary",
  "theme_color": "#0b0e1a",
  "background_color": "#06080f",
  "categories": [
    "productivity",
    "utilities",
    "education",
    "business"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Open Chat",
      "short_name": "Chat",
      "description": "Start a new AI conversation",
      "url": "/chat",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Code Generator",
      "short_name": "Code",
      "description": "Generate and debug code with AI",
      "url": "/code",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "file_handlers": [
    {
      "action": "/chat",
      "accept": {
        "text/plain": [".txt"],
        "text/markdown": [".md"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+nexus",
      "url": "/chat?q=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
