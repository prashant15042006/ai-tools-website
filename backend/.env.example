# Example environment variables for the backend
# Copy this file to `.env` and fill with real values (DO NOT commit `.env`).

# OpenRouter / ZAI (required)
ZAI_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY

# Nemotron (optional - used for fast TTS / alternate provider)
NEMOTRON_API_KEY=REPLACE_WITH_YOUR_NEMOTRON_API_KEY
NEMOTRON_API_URL=https://your-nemotron-endpoint.example

# Optional: override server port
# PORT=5001
