# Example environment variables for the backend
# Copy this file to `.env` and fill with real values (DO NOT commit `.env`).

# OpenRouter API Key for nvidia/nemotron-ultra model
OPENROUTER_KEY_NEMOTRON=REPLACE_WITH_YOUR_OPENROUTER_KEY

# OpenRouter API Key for google/gemma4-26b model
OPENROUTER_KEY_GEMMA=REPLACE_WITH_YOUR_OPENROUTER_KEY

# Optional: override server port
# PORT=5001
